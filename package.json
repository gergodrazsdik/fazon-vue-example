{
  "name": "fazon-vue-example",
  "version": "0.0.0",
  "private": true,
  "description": "The example Vue 3 component library of Fazon: components built from written specs and verified by rendering.",
  "license": "MIT-0",
  "homepage": "https://github.com/gergodrazsdik/fazon-vue-example#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergodrazsdik/fazon-vue-example.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/tokens.css",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "sync": "fazon sync",
    "sync:check": "fazon sync --check",
    "lint": "eslint . && stylelint \"src/components/**/*.{vue,css}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build-storybook": "storybook build",
    "storybook": "storybook dev --port 6006"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "reka-ui": "2.11.0"
  },
  "devDependencies": {
    "@fazon/adapter-vue": "file:.fazon-framework/a25ba88eab262f3a7c24a8d49903a8cd730e0057/packages/adapter-vue",
    "@storybook/vue3-vite": "10.6.7",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fazon": "file:.fazon-framework/a25ba88eab262f3a7c24a8d49903a8cd730e0057/packages/cli",
    "lucide-static": "1.76.0",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "storybook": "10.6.7",
    "style-dictionary": "5.8.0",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-vue": "3.1.0",
    "vue": "3.5.45",
    "vue-component-meta": "3.3.14",
    "vue-tsc": "3.3.14"
  }
}
