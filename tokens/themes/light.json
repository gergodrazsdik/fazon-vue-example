{
  "$description": "Colour roles in the light theme.",
  "color": {
    "surface": {
      "base": { "$type": "color", "$value": "{color.neutral.0}" },
      "raised": { "$type": "color", "$value": "{color.neutral.0}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.50}" },
      "hover": { "$type": "color", "$value": "{color.neutral.100}" },
      "active": { "$type": "color", "$value": "{color.neutral.200}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.900}" }
    },
    "overlay": { "$type": "color", "$value": "{color.black-alpha.48}" },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.900}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.600}" },
      "disabled": { "$type": "color", "$value": "{color.neutral.400}" },
      "action": { "$type": "color", "$value": "{color.blue.600}" },
      "on-action": { "$type": "color", "$value": "{color.neutral.0}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.0}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.200}" },
      "strong": { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.blue.600}" },
      "primary-hover": { "$type": "color", "$value": "{color.blue.700}" },
      "primary-active": { "$type": "color", "$value": "{color.blue.800}" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{color.blue.500}" }
    },
    "control": {
      "track": { "$type": "color", "$value": "{color.neutral.500}" },
      "thumb": { "$type": "color", "$value": "{color.neutral.0}" }
    },
    "status": {
      "info": {
        "surface": { "$type": "color", "$value": "{color.blue.50}" },
        "text": { "$type": "color", "$value": "{color.blue.700}" },
        "border": { "$type": "color", "$value": "{color.blue.600}" }
      },
      "success": {
        "surface": { "$type": "color", "$value": "{color.green.50}" },
        "text": { "$type": "color", "$value": "{color.green.700}" },
        "border": { "$type": "color", "$value": "{color.green.600}" }
      },
      "warning": {
        "surface": { "$type": "color", "$value": "{color.amber.50}" },
        "text": { "$type": "color", "$value": "{color.amber.700}" },
        "border": { "$type": "color", "$value": "{color.amber.600}" }
      },
      "danger": {
        "surface": { "$type": "color", "$value": "{color.red.50}" },
        "text": { "$type": "color", "$value": "{color.red.700}" },
        "border": { "$type": "color", "$value": "{color.red.600}" }
      }
    }
  }
}
