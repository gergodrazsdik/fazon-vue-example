{
  "$description": "Colour roles in the dark theme.",
  "color": {
    "surface": {
      "base": { "$type": "color", "$value": "{color.neutral.950}" },
      "raised": { "$type": "color", "$value": "{color.neutral.900}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.900}" },
      "hover": { "$type": "color", "$value": "{color.neutral.800}" },
      "active": { "$type": "color", "$value": "{color.neutral.700}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.100}" }
    },
    "overlay": { "$type": "color", "$value": "{color.black-alpha.64}" },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.100}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.400}" },
      "disabled": { "$type": "color", "$value": "{color.neutral.600}" },
      "action": { "$type": "color", "$value": "{color.blue.400}" },
      "on-action": { "$type": "color", "$value": "{color.neutral.950}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.900}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.800}" },
      "strong": { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.blue.400}" },
      "primary-hover": { "$type": "color", "$value": "{color.blue.300}" },
      "primary-active": { "$type": "color", "$value": "{color.blue.200}" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{color.blue.400}" }
    },
    "control": {
      "track": { "$type": "color", "$value": "{color.neutral.500}" },
      "thumb": { "$type": "color", "$value": "{color.neutral.950}" }
    },
    "status": {
      "info": {
        "surface": { "$type": "color", "$value": "{color.blue.950}" },
        "text": { "$type": "color", "$value": "{color.blue.300}" },
        "border": { "$type": "color", "$value": "{color.blue.400}" }
      },
      "success": {
        "surface": { "$type": "color", "$value": "{color.green.950}" },
        "text": { "$type": "color", "$value": "{color.green.300}" },
        "border": { "$type": "color", "$value": "{color.green.400}" }
      },
      "warning": {
        "surface": { "$type": "color", "$value": "{color.amber.950}" },
        "text": { "$type": "color", "$value": "{color.amber.300}" },
        "border": { "$type": "color", "$value": "{color.amber.400}" }
      },
      "danger": {
        "surface": { "$type": "color", "$value": "{color.red.950}" },
        "text": { "$type": "color", "$value": "{color.red.300}" },
        "border": { "$type": "color", "$value": "{color.red.400}" }
      }
    }
  }
}
