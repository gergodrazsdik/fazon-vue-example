  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": [
        { "color": "{color.black-alpha.8}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        { "color": "{color.black-alpha.12}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": "{color.black-alpha.8}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "3": {
